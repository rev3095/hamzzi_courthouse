{
  "name": "hamzzi-courthouse",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:live": "vitest run --config vitest.live.config.ts",
    "eval:demo": "vitest run --config evals/vitest.eval.config.ts --silent=false",
    "docs:check": "node scripts/docs-check.mjs",
    "figma:tokens": "node scripts/figma-tokens-diff.mjs",
    "db:push": "node --env-file=.env.local scripts/db-push.mjs",
    "db:verify": "uv run --no-project --with \"psycopg[binary]\" --env-file .env.local python -X utf8 scripts/verify_db.py",
    "collector:test": "cd collector && uv run pytest && uv run ruff check .",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.137.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "korean-law-mcp": "4.15.6",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "^2.121.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.34.7"
}
